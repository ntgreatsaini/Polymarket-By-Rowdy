# ============================
# Polymarket Telegram Bot
# Environment Configuration
# ============================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# --- Groq (FREE — ultra-fast Llama 3.3 70B inference) ---
# Get free API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (FREE tier) ---
# Get free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# --- News APIs ---
NEWS_API_KEY=your_newsapi_key
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc

# --- Crypto APIs ---
COINGECKO_API_KEY=your_coingecko_api_key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Financial Data ---
FRED_API_KEY=your_fred_api_key

# --- Sports / Odds ---
THE_ODDS_API_KEY=your_odds_api_key

# --- OddPool (whale tracking + cross-venue arbitrage) ---
# Get API key: https://docs.oddpool.com (Pro plan for whale tracking)
ODDPOOL_API_KEY=your_oddpool_api_key

# --- Blue Minds (OpenAI-compatible multi-model AI proxy) ---
# Get API key: https://doc.bluesminds.com/ (free tier: 500 credits)
BLUESMINDS_API_KEY=your_bluesminds_api_key
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1
BLUESMINDS_MODEL=deepseek-chat

# --- Merlin (Polymarket trader analytics) ---
# No API key needed — uses Polymarket Data API leaderboard
MERLIN_BASE_URL=https://merlin.trade

# --- Polymarket ---
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/polymarket_bot
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/polymarket_bot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
SIGNAL_MIN_CONFIDENCE=65
SIGNAL_MIN_LIQUIDITY=5000
WHALE_MIN_TRADE_SIZE=1000
SCAN_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=1800

# --- Branding ---
TELEGRAM_CHANNEL_LINK=https://t.me/RowdyxCrypto
X_PROFILE_LINK=https://x.com/0xRowdyBhai
